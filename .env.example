DATABASE_URL="postgresql://ebook:ebook@localhost:5432/ebook_liff?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="change-me-to-at-least-32-characters-long-secret"
R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
R2_ACCOUNT_ID="example-r2-account-id"
R2_ACCESS_KEY_ID="example-r2-access-key"
R2_SECRET_ACCESS_KEY="example-secret-min8chars"
R2_BUCKET="ebook-chunks"
R2_BUCKET_NAME="ebook-chunks"
R2_PUBLIC_DOMAIN="https://media.example.com"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="ebook_liff"
POSTGRES_USER="ebook"
POSTGRES_PASSWORD="changeme-8chars-min"
REDIS_CLUSTER_NODES="localhost:6379"
REDIS_PASSWORD="changeme-8chars-min"
DATABASE_POOL_MIN="10"
DATABASE_POOL_MAX="100"
EASYSLIP_API_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:3001"

# LINE MINI App
LINE_MINI_APP_NAME="<mini-app-name>"
LINE_MINI_APP_ENDPOINT_URL="<endpoint-url>"
LINE_MINI_APP_CHANNEL_ID_DEVELOPING="<developing-channel-id>"
LINE_MINI_APP_CHANNEL_ID_REVIEW="<review-channel-id>"
LINE_MINI_APP_CHANNEL_ID_PUBLISHED="<published-channel-id>"
LINE_MINI_APP_CHANNEL_SECRET_DEVELOPING="<developing-channel-secret>"
LINE_MINI_APP_CHANNEL_SECRET_REVIEW="<review-channel-secret>"
LINE_MINI_APP_CHANNEL_SECRET_PUBLISHED="<published-channel-secret>"
LINE_MINI_APP_LIFF_ID_DEVELOPING="<developing-liff-id>"
LINE_MINI_APP_LIFF_ID_REVIEW="<review-liff-id>"
LINE_MINI_APP_LIFF_ID_PUBLISHED="<published-liff-id>"
LINE_MINI_APP_LIFF_URL_DEVELOPING="https://miniapp.line.me/<developing-liff-id>"
LINE_MINI_APP_LIFF_URL_REVIEW="https://miniapp.line.me/<review-liff-id>"
LINE_MINI_APP_LIFF_URL_PUBLISHED="https://miniapp.line.me/<published-liff-id>"

# Active LINE environment (point these at developing/review/published as needed)
# LINE Login / MINI App channel — used for ID token `aud` verification
LINE_LOGIN_CHANNEL_ID="<login-channel-id>"
LINE_CHANNEL_ID="<channel-id>"

# Phase 131 — Hybrid web identity
# LINE Web OAuth uses the MINI App / LINE Login channel secret (NOT the
# Messaging API webhook secret below). Register this callback in the LINE
# console: https://<your-origin>/api/auth/callback/line
LINE_LOGIN_CHANNEL_SECRET="<mini-app-channel-secret>"
LINE_LOGIN_SCOPE="openid profile"
LINE_EMAIL_VERIFIED="false"

# Google OIDC. Authorized redirect URI:
#   https://<your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OIDC_SCOPE="openid email profile"

# Public app origin used for magic links and OAuth redirect URIs.
# Empty = derive from the request origin (ngrok/localhost friendly).
WEB_APP_URL=""

# Email magic link delivery — configure SMTP *or* an HTTP email API.
# With neither, development logs the link and production returns 503.
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@ebook.local"
EMAIL_FROM_NAME="Ebook Platform"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# Messaging API channel (LINE Official Account) — separate from the MINI App channel
MESSAGING_API_CHANNEL_ID="<messaging-api-channel-id>"
LINE_CHANNEL_SECRET="<messaging-api-channel-secret>"
LINE_CHANNEL_ACCESS_TOKEN="<messaging-api-channel-access-token>"
LINE_OA_CHANNEL_SECRET="<messaging-api-channel-secret>"
LINE_OA_USER_ID="<line-user-id>"
ADMIN_LINE_USER_ID="<admin-line-user-id>"
LINE_WEBHOOK_URL="<messaging-api-webhook-url>"

LIFF_ID="<liff-id>"
LINE_LIFF_ID="<liff-id>"
NEXT_PUBLIC_DEFAULT_LIFF_ID="<liff-id>"
NEXT_PUBLIC_LIFF_ID="<liff-id>"
NEXT_PUBLIC_LINE_LIFF_ID="<liff-id>"
NEXT_PUBLIC_LIFF_URL_BASE="https://miniapp.line.me/<liff-id>"
LIFF_BASE_URL="https://miniapp.line.me/<liff-id>"

# Linked LINE Official Account
LINE_OA_BASIC_ID="<oa-basic-id>"
NEXT_PUBLIC_LINE_OA_URL="https://line.me/R/ti/p/@<oa-basic-id>"

# Browser origin allowed by the backend (CORS)
CORS_ALLOWED_ORIGINS="<endpoint-origin>"
