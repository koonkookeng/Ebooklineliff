{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/shared": ["packages/shared/src/index.ts"],
      "@repo/db": ["packages/db/src/index.ts"],
      "@shared/*": ["packages/shared/src/*"],
      "@db": ["packages/db/src/index.ts"]
    }
  }
}
