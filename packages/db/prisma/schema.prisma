model PayoutTransaction {
  id                String          @id @default(uuid())
  // Atomic Phase 081: finance-owned columns are optional so all Phase 073
  // merchant rows stay valid (expand-contract; RISK_CALL deviation from the
  // 081 sketch where both sides are required — backfill lands separately).
  merchantProfileId String?
  merchantProfile   MerchantProfile? @relation(fields: [merchantProfileId], references: [id])
  userId            String?
  user              User?           @relation("FinancePayouts", fields: [userId], references: [id])
  grossAmount       Decimal         @db.Decimal(12, 2)
  withholdingTax    Decimal         @db.Decimal(10, 2)
  processingFee     Decimal         @db.Decimal(10, 2)
  netAmount         Decimal         @db.Decimal(12, 2)
  payoutStatus      PayoutStatus    @default(PENDING)
  taxCertPdfUrl     String?
  // Atomic Phase 081: bank-settlement + e-withholding columns.
  taxRatePercent       Decimal  @default(3.00) @db.Decimal(5, 2)
  taxWithheldAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  netTransferAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  status               PayoutStatus @default(REQUESTED)
  bankAccountDetail    Json?
  withholdingTaxRecord WithholdingTaxRecord?
  // Atomic Phase 086: human payout number (nullable for pre-086 rows; fixes
  // an 081 latent bug where the repo wrote payoutNo with no column).
  payoutNo             String?         @unique
  // Atomic Phase 086: bank batch reference (callback replay key).
  transRef             String?         @unique
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([merchantProfileId])
  @@index([payoutStatus])
  @@index([userId])
  @@index([status])
  @@index([payoutNo])
  @@index([transRef])
}

// Atomic Phase 081 §4.1: double-entry ledger segment (schema.md canonical).
model FinancialAccount {
