  // boundary so DB/GraphQL responses round-trip without lossy mapping.
  targetType     String
  targetId       String
  customPath     String
  affiliateCode  String?
  campaignId     String?
  couponCode     String?
  signature      String
  clickCount     Int            @default(0)
