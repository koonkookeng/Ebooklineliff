// SSOT Phase 0 core — source: Phases/phase_000.md §4.1
// Full 279-model version is generated to packages/db/prisma/schema.full.prisma by scaffold script from schema.md
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

enum UserRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  CONTENT_MODERATOR
  SUPPORT_STAFF
  INSTRUCTOR
  SELLER
  MEMBER
}

enum ProductType {
  PHYSICAL_BOOK
  EBOOK
  ELEARNING_COURSE
  LIVE_CLASS
  HYBRID_BUNDLE
}

// Atomic Phase 008: catalog lifecycle (DRAFT -> PUBLISHED -> ARCHIVED/SUSPENDED)
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum ContentAccessType {
  FULL_PURCHASE
  SUBSCRIPTION
  CORPORATE_LICENSE
  TIME_LIMITED_RENTAL
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                String                   @id @default(uuid())
  lineUserId        String?                  @unique
  email             String?                  @unique
  phone             String?                  @unique
  passwordHash      String?
  role              UserRole                 @default(MEMBER)
  kycStatus         KYCStatus                @default(NOT_SUBMITTED)
  displayName       String
  avatarUrl         String?
  walletBalance     Decimal                  @default(0.00) @db.Decimal(12, 2)
  rewardPoints      Int                      @default(0)
  affiliateCode     String                   @unique @default(uuid())
  referredById      String?
  referredBy        User?                    @relation("AffiliateReferrals", fields: [referredById], references: [id])
  referrals         User[]                   @relation("AffiliateReferrals")
  addresses         UserAddress[]
  kycDetail         CreatorKYC?
  auditLogs         AuditLog[]
  accounts          Account[]
  sessions          Session[]
  authAuditLogs     AuthAuditLog[]
  // Phase 006: optional multi-tenant binding (expand-contract; required after backfill)
  tenantId          String?
  tenant            Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lineProfile       LineAuthProfile?
  entitlements      Entitlement[]
  orders            Order[]
  cart              Cart?
  readingProgress   EbookReadingProgress[]
  learningProgress  CourseLearningProgress[]
  // Atomic Phase 047: in-video quiz attempts
  quizAttempts      QuizAttempt[]
  // Atomic Phase 048: course certificates
  courseCertificates CourseCertificate[]
  // Atomic Phase 049: DRM sessions (ephemeral tile-permutation grants)
  drmSessions       DrmSession[]
  // Atomic Phase 061: dual-DRM ephemeral session keys (HMAC permutation grants)
  drmSecurityKeys   DrmSecurityKey[]
  drmViolationLogs  DrmViolationLog[]
  // Atomic Phase 062: offline PWA device sessions (bulk-sync ledger)
  offlineDeviceSessions OfflineDeviceSession[]
  // Atomic Phase 063: offline sync audit + DRM lease grants
  offlineSyncAudits     OfflineSyncLog[]
  drmOfflineLeases      DrmOfflineLease[]
  // Atomic Phase 065: in-video timestamped lesson notes
  notes             LessonNote[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  scannedQrSessions QrSessionNonce[]         @relation("QrScannedBy")
  deviceSessions    UserDeviceSession[]
  // Atomic Phase 017: internal wallet (Meb-Killer Credits, bonus-first debit)
  wallets           Wallet[]
  // Atomic Phase 022: device viewport/safe-area metrics (async analytics, nullable user)
  userDeviceMetrics UserDeviceMetric[]
  // Atomic Phase 026: viral share logs + referral attributions
  shareLogs           ShareLog[]
  viralAttributions   ViralAttribution[]
  // Atomic Phase 027: LIFF navigation session (single active snapshot per user)
  navigationSessions  UserNavigationSession[]
  // Atomic Phase 031: viewport keep-alive rows (one per user/tenant/viewport)
  liffSessionStates   UserLiffSessionState[]
  // Atomic Phase 032: permission audit trail + district-level location cache
  permissionAudits    PermissionAuditLog[]
  locationCache       UserLocationCache?
  // Atomic Phase 034: LINE OA friendship flag + audit trail
  isOAFriend            Boolean               @default(false)
  oaFriendshipUpdatedAt DateTime?
  oaFriendshipLogs      LineOAFriendshipLog[]
  // Atomic Phase 041: reader bookmarks + highlights + reading preferences
  bookmarks         EbookBookmark[]
  highlights        EbookHighlight[]
  readerPreference  UserReaderPreference?
  // Atomic Phase 066: cross-platform synced reading preferences
  readingPreference UserReadingPreference?
  // Atomic Phase 042: watermark seeds + tamper audit trail
  watermarkSeeds      WatermarkSeedLog[]
  securityViolations  SecurityViolationLog[]
  // Atomic Phase 050: HLS stream sessions + scraper blacklist (anti-rip guard)
  videoStreamSessions VideoStreamSession[]
  scraperBlacklists   ScraperBlacklist[]
  // Atomic Phase 052: read/watch telemetry rows (async batch writer owns writes)
  ebookPageAnalytics  EbookPageAnalytics[]
  videoWatchAnalytics VideoWatchAnalytics[]
  // Atomic Phase 067: ABR quality telemetry ledger
  streamTelemetry     VideoStreamTelemetry[]
  // Atomic Phase 068: offline download licenses + device storage profiles
  offlineLicenses     OfflineLicense[]
  storageProfiles     DeviceStorageProfile[]
  // Atomic Phase 069: network telemetry segments
  networkTelemetry    NetworkTelemetryLog[]
  // Atomic Phase 070: cross-device vector-clock state
  // (ActiveDeviceSession stays relation-free per Phase 057 — the viewport
  // guard counts by userId field, no schema touch).
  crossDeviceStates   CrossDeviceSyncState[]
  // Atomic Phase 071: tenant memberships (per-storefront RBAC)
  tenantMappings      UserTenantMapping[]
  // Atomic Phase 073: merchant storefront profile (1:1 seller account)
  merchantProfile     MerchantProfile?
  // Atomic Phase 075: stock audit authorship
  stockMovementLogs   StockMovementLog[]
  // Atomic Phase 079: multi-tier affiliate ledger
  commissionsEarned    CommissionLog[] @relation("EarnedCommissions")
  commissionsGenerated CommissionLog[] @relation("GeneratedCommissions")
  affiliatePayouts     AffiliatePayout[]
  shareEvents          ShareEvent[]

  @@index([lineUserId])
  @@index([email])
  @@index([phone])
  @@index([affiliateCode])
  @@index([tenantId])
  // Atomic Phase 034: friendship-segment queries (OA conversion funnel)
  @@index([isOAFriend])
}

// Atomic Phase 006: tenant registry for LIFF seamless auth (lineChannelId selects verify audience).
// NOTE: `users` back-relation intentionally omitted (one-sided relation) until the User.tenantId
// backfill migration lands; AuthService binds tenantId at auto-provision time.
// Atomic Phase 071: TenantStatus lifecycle + branding/domain/membership relations
// (expand-contract additive; Order stays one-sided — no orders[] back-relation
// until Order.tenant FK backfill lands).
enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
  ARCHIVED
}

model Tenant {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  domain        String?   @unique
  lineChannelId String?
  logoUrl       String?
  primaryColor  String    @default("#00C300")
  isActive      Boolean   @default(true)
  // Phase 008: dynamic branding tokens (--primary-color, etc.) + catalog ownership
  customCssVars Json?
  products      Product[]
  brandingConfig TenantBrandingConfig?
  customDomains TenantDomain[]
  memberships   UserTenantMapping[]
  themeConfig   CompanyTheme?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  User          User[]

  @@index([slug])
  @@index([status])
}

// Atomic Phase 071: verified custom domains (brand-a.com -> tenant).
model TenantDomain {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domainName String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([domainName])
  @@index([tenantId])
}

// Atomic Phase 071: per-tenant dynamic branding (CSS vars injection source).
model TenantBrandingConfig {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("#ffffff")
  accentColor    String   @default("#10b981")
  logoUrl        String
  faviconUrl     String?
  customFontUrl  String?
  updatedAt      DateTime @updatedAt
}

// Atomic Phase 071: user <-> tenant membership (RBAC per storefront).
model UserTenantMapping {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// Atomic Phase 072: full company theme (logo set + typography + surfaces).
// 1:1 with Tenant; served via Redis `tenant:company-theme:{slug}` (24h).
model CompanyTheme {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor         String   @default("#059669")
  secondaryColor       String   @default("#10B981")
  accentColor          String   @default("#F59E0B")
  backgroundColor      String   @default("#FFFFFF")
  textColor            String   @default("#0F172A")
  borderRadiusRem      Float    @default(0.5)
  primaryLogoUrl       String
  squareLogoUrl        String?
  faviconUrl           String?
  watermarkLogoUrl     String?
  fontFamily           String   @default("Inter")
  fontUrl              String?
  isAccessibilityValid Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
}

// Atomic Phase 073: merchant & studio segment (dashboard SSOT).
// Atomic Phase 076: union with 076 lifecycle (schema.md canonical).
enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  QUEUED_FOR_BOOKING
  BOOKED
  LABEL_GENERATED
  PRINTED
  IN_TRANSIT
  DELIVERY_FAILED
  CANCELLED
}

// Atomic Phase 076: multi-carrier vocabulary (schema.md canonical).
enum CourierProvider {
  FLASH_EXPRESS
  KEX_EXPRESS
  JT_EXPRESS
  THAILAND_POST
  CUSTOM_FLEET
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  // Atomic Phase 079: affiliate payout request lifecycle (schema.md canonical union)
  REQUESTED
}

// Atomic Phase 079: multi-tier affiliate vocabulary (schema.md canonical).
enum AffiliateTierLevel {
  TIER_1_DIRECT
  TIER_2_INDIRECT
  TIER_3_COMMUNITY
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  BLOCKED_FRAUD
}

model MerchantProfile {
  id              String              @id @default(uuid())
  tenantId        String              @unique
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName       String
  storeSlug       String              @unique
  logoUrl         String?
  bannerUrl       String?
  taxId           String?
  vatRegistered   Boolean             @default(false)
  bankName        String
  bankAccountNo   String
  bankAccountName String
  warehouses      Warehouse[]
  payouts         PayoutTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId])
}

model Warehouse {
  id                String             @id @default(uuid())
  merchantProfileId String
  merchantProfile   MerchantProfile  @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)
  warehouseName     String
  addressLine       String
  province          String
  postalCode        String
  isPrimary         Boolean            @default(true)
  fulfillments      OrderFulfillment[]
  // Atomic Phase 075: stock ledger extensions (additive; 073 cols untouched).
  // `code` is the operator-facing key (GQL §3.2); `name` falls back to
  // warehouseName at the service layer when unset.
  tenantId          String?
  code              String?            @unique
  name              String?
  isMainWarehouse   Boolean            @default(false)
  isActive          Boolean            @default(true)
  stocks            WarehouseStock[]
  movementLogs      StockMovementLog[]
  // Atomic Phase 076: batch fulfillment ledger rows
  fulfillmentItems  FulfillmentItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
  @@index([code])
}

model OrderFulfillment {
  id               String            @id @default(uuid())
  orderId          String            @unique
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  status           FulfillmentStatus @default(UNFULFILLED)
  courierName      String?
  trackingNumber   String?           @unique
  shippingLabelUrl String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([warehouseId])
  @@index([status])
}

// Atomic Phase 076: tenant carrier credentials (1:1 per provider).
model LogisticsCarrierConfig {
  id            String          @id @default(uuid())
  tenantId      String
  provider      CourierProvider
  accountNo     String
  apiKey        String
  apiSecret     String?
  sortingCode   String?
  isAutoBooking Boolean         @default(true)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, provider])
}

// Atomic Phase 076: batch booking header (BDD-1: 100 items < 2s).
model FulfillmentBatch {
  id              String            @id @default(uuid())
  batchNumber     String            @unique
  tenantId        String
  courierProvider CourierProvider
  totalOrders     Int
  successCount    Int               @default(0)
  failureCount    Int               @default(0)
  status          String            @default("PROCESSING")
  items           FulfillmentItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
}

// Atomic Phase 076: per-order fulfillment ledger (queue -> booked -> label -> printed).
model FulfillmentItem {
  id              String            @id @default(uuid())
  batchId         String?
  batch           FulfillmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  courierProvider CourierProvider
  trackingNumber  String?           @unique
  sortingCode     String?
  labelUrl        String?
  status          FulfillmentStatus @default(UNFULFILLED)
  printedAt       DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([courierProvider])
  @@index([status])
  @@index([trackingNumber])
}

// Atomic Phase 077: API-integrated carrier vocabulary (schema.md canonical).
enum LogisticsCarrier {
  FLASH_EXPRESS
  KERRY_EXPRESS
  THAILAND_POST
}

enum ShipmentStatus {
  PENDING_BOOKING
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
}

// Atomic Phase 077: tenant carrier API credentials (multi-tenant scope;
// schema.md canonical is global-@unique — tenant scope documented deviation).
model CarrierApiConfig {
  id        String           @id @default(uuid())
  tenantId  String           @default("default")
  carrier   LogisticsCarrier
  mchId     String
  apiKey    String           @db.Text
  apiSecret String           @db.Text
  isSandbox Boolean          @default(false)
  isActive  Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, carrier])
}

// Atomic Phase 077: shipment tracking ledger (webhook-driven status).
model Shipment {
  id              String           @id @default(uuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier         LogisticsCarrier
  trackingNumber  String           @unique
  courierOrderId  String?
  labelUrl        String?          @db.Text
  status          ShipmentStatus   @default(PENDING_BOOKING)
  weightGrams     Int
  shippingFee     Decimal          @db.Decimal(10, 2)
  senderName      String
  senderPhone     String
  recipientName   String
  recipientPhone  String
  destinationAddr String           @db.Text
  trackingLogs    TrackingHistory[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([trackingNumber])
  @@index([carrier, status])
}

model TrackingHistory {
  id             String   @id @default(uuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  statusCode     String
  statusText     String
  location       String?
  rawPayload     Json?
  eventTimestamp DateTime
  createdAt      DateTime @default(now())

  @@index([shipmentId])
}

model LogisticsWebhookLog {
  id           String   @id @default(uuid())
  carrier      String
  payload      Json
  isProcessed  Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())
}

// Atomic Phase 079: per-product (or global NULL) tier rate card.
model AffiliateTierConfig {
  id               String   @id @default(uuid())
  productId        String?  @unique
  tier1RatePercent Decimal  @default(10.00) @db.Decimal(5, 2)
  tier2RatePercent Decimal  @default(3.00) @db.Decimal(5, 2)
  tier3RatePercent Decimal  @default(1.00) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Atomic Phase 079: immutable per-tier commission ledger (audit trail).
model CommissionLog {
  id               String             @id @default(uuid())
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiaryId    String
  beneficiary      User               @relation("EarnedCommissions", fields: [beneficiaryId], references: [id])
  originBuyerId    String
  originBuyer      User               @relation("GeneratedCommissions", fields: [originBuyerId], references: [id])
  tierLevel        AffiliateTierLevel
  orderAmount      Decimal            @db.Decimal(10, 2)
  commissionRate   Decimal            @db.Decimal(5, 2)
  commissionAmount  Decimal            @db.Decimal(10, 2)
  status           CommissionStatus   @default(APPROVED)
  fraudReason      String?
  createdAt        DateTime           @default(now())

  @@index([beneficiaryId])
  @@index([orderId])
  @@index([originBuyerId])
}

// Atomic Phase 079: payout request with 3% e-withholding tax split.
model AffiliatePayout {
  id                 String       @id @default(uuid())
  payoutNo           String       @unique
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAmount    Decimal      @db.Decimal(10, 2)
  taxWithheldAmount  Decimal      @db.Decimal(10, 2)
  netPayoutAmount    Decimal      @db.Decimal(10, 2)
  bankName           String
  bankAccountNumber  String
  bankAccountName    String
  status             PayoutStatus @default(REQUESTED)
  processedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([payoutNo])
}

// Atomic Phase 079 (+080): viral share event with signed ref token.
model ShareEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetType   String   @default("PRODUCT_PDP")
  refToken     String   @unique
  shareChannel String   @default("LINE_FLEX")
  clickCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([refToken])
}

model PayoutTransaction {
  id                String          @id @default(uuid())
  merchantProfileId String
  merchantProfile   MerchantProfile @relation(fields: [merchantProfileId], references: [id])
  grossAmount       Decimal         @db.Decimal(12, 2)
  withholdingTax    Decimal         @db.Decimal(10, 2)
  processingFee     Decimal         @db.Decimal(10, 2)
  netAmount         Decimal         @db.Decimal(12, 2)
  payoutStatus      PayoutStatus    @default(PENDING)
  taxCertPdfUrl     String?
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([merchantProfileId])
  @@index([payoutStatus])
}

model MerchantAnalyticsDaily {
  id                 String   @id @default(uuid())
  tenantId           String
  recordDate         DateTime @db.Date
  totalGmv           Decimal  @default(0.00) @db.Decimal(12, 2)
  totalOrders        Int      @default(0)
  ebookSalesCount    Int      @default(0)
  courseSalesCount   Int      @default(0)
  physicalSalesCount Int      @default(0)
  newStudentsCount   Int      @default(0)

  @@unique([tenantId, recordDate])
  @@index([tenantId])
}

// Atomic Phase 075: per-warehouse SKU ledger + immutable audit trail.
model WarehouseStock {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  physicalDetailId String
  physicalDetail   PhysicalDetail @relation(fields: [physicalDetailId], references: [id], onDelete: Cascade)
  stockQty         Int            @default(0)
  reservedQty      Int            @default(0)
  safetyStock      Int            @default(10)
  rackLocation     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([warehouseId, physicalDetailId])
  @@index([warehouseId])
  @@index([physicalDetailId])
}

model StockMovementLog {
  id             String    @id @default(uuid())
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  sku            String
  previousQty    Int
  newQty         Int
  quantityDelta  Int
  adjustmentType String
  remark         String?
  updatedBy      String
  user           User      @relation(fields: [updatedBy], references: [id])
  createdAt      DateTime  @default(now())

  @@index([sku])
  @@index([warehouseId])
  @@index([createdAt])
}

// Atomic Phase 074: builder draft cache (Redis owns hot state, PG persists).
model ProductDraft {
  id          String      @id @default(uuid())
  sellerId    String
  productType ProductType
  draftName   String      @default("Untitled Draft")
  stepIndex   Int         @default(1)
  payloadJson Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sellerId])
  @@index([updatedAt])
}

// Atomic Phase 006: LINE identity profile (1:1 with User). Canonical runtime sessions stay in
// `Session` (Phase 005 superset); no duplicate AuthSession table (zero-redundant policy).
model LineAuthProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineSub     String   @unique
  displayName String
  pictureUrl  String?
  email       String?
  rawPayload  Json
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([lineSub])
}

// Atomic Phase 007: QR cross-platform login sync (Redis owns hot state w/ 60s TTL;
// Postgres rows exist for audit/traceability + device binding).
enum QrStatus {
  PENDING
  SCANNED
  AUTHORIZED
  EXPIRED
  REJECTED
}

model QrSessionNonce {
  id                String   @id @default(uuid())
  qrToken           String   @unique @default(uuid())
  nonceHash         String   @unique
  socketClientId    String
  status            QrStatus @default(PENDING)
  scannedByUserId   String?
  scannedByUser     User?    @relation("QrScannedBy", fields: [scannedByUserId], references: [id], onDelete: SetNull)
  deviceFingerprint String?
  desktopIpAddress  String?
  mobileIpAddress   String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([qrToken])
  @@index([expiresAt])
}

// Atomic Phase 056: viewport runtime environment (adaptive LIFF/Web engine).
enum RuntimeEnvironment {
  LINE_LIFF_MOBILE
  LINE_LIFF_DESKTOP
  WEB_MOBILE_PWA
  WEB_DESKTOP_WORKSPACE
}

model UserDeviceSession {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String   @unique
  deviceType        String // "DESKTOP_WEB", "LINE_LIFF", "MOBILE_APP"
  deviceFingerprint String
  ipAddress         String
  lastActiveAt      DateTime @default(now())
  isRevoked         Boolean  @default(false)
  createdAt         DateTime @default(now())
  // Phase 056 expand-contract (all optional/defaulted; zero-downtime safe):
  lastViewportMode  RuntimeEnvironment @default(WEB_DESKTOP_WORKSPACE)
  deviceUserAgent   String?
  lastIpAddress     String?
  activeSession     Boolean            @default(true)
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([deviceFingerprint])
}

model Product {
  id             String                      @id @default(uuid())
  // Phase 008: optional multi-tenant ownership (expand-contract; required after backfill)
  tenantId       String?
  tenant         Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerId       String
  title          String
  slug           String                      @unique
  description    String                      @db.Text
  coverImageUrl  String
  productType    ProductType
  status         ProductStatus               @default(DRAFT)
  price          Decimal                     @db.Decimal(10, 2)
  discountPrice  Decimal?                    @db.Decimal(10, 2)
  // Phase 009: faceted filter + hybrid search (tsvector + pgvector HNSW)
  ratingAverage  Decimal                     @default(0.00) @db.Decimal(3, 2)
  reviewCount    Int                         @default(0)
  embedding      Unsupported("vector(768)")?
  searchVector   Unsupported("tsvector")?
  isPublished    Boolean                     @default(false)
  physicalDetail PhysicalDetail?
  ebookDetail    EbookDetail?
  courseDetail   CourseDetail?
  // Atomic Phase 038: 1:1 pipeline job per product (ingestion state machine)
  bookProcessingJob BookProcessingJob?
  // Hybrid Bundle self-referential many-to-many (parent bundle -> child products)
  bundleParents  BundleItem[]                @relation("ChildProducts")
  bundleChildren BundleItem[]                @relation("ParentBundle")
  categories     ProductCategoryMap[]
  tags           ProductTagMap[]
  entitlements   Entitlement[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  // Atomic Phase 049: DRM sessions bound to this product
  drmSessions    DrmSession[]
  // Atomic Phase 061: dual-DRM ephemeral session keys bound to this product
  drmSecurityKeys DrmSecurityKey[]
  drmViolationLogs DrmViolationLog[]
  // Atomic Phase 063: offline DRM lease grants for this product
  drmOfflineLeases DrmOfflineLease[]
  // Soft-delete: unpublished + timestamped, stock rows preserved for fulfillment
  deletedAt      DateTime?
  // Atomic Phase 023: per-product header overrides (dynamic title/branding)
  headerConfig   HeaderConfig?
  // Atomic Phase 026: viral share logs
  shareLogs      ShareLog[]
  // Atomic Phase 079: signed referral share events
  shareEvents    ShareEvent[]
  // Atomic Phase 042: watermark seed issuance per product
  watermarkSeeds WatermarkSeedLog[]
  // Phase 010: storefront merchandising (expand-contract; defaults keep old rows valid)
  isFeatured     Boolean                     @default(false)
  soldCount      Int                         @default(0)
  // Atomic Phase 051: free-preview engagement log (conversion funnel analytics)
  previewLogs    PreviewUsageLog[]
  // Atomic Phase 068: offline download licenses per product
  offlineLicenses OfflineLicense[]
  // Atomic Phase 070: cross-device vector-clock rows per product
  crossDeviceStates CrossDeviceSyncState[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([tenantId])
  @@index([sellerId])
  @@index([productType])
  @@index([status, isPublished])
  @@index([slug])
  @@index([price])
  @@index([ratingAverage])
  @@index([isPublished])
  @@index([sellerId, isPublished])
  @@index([productType, isPublished])
  @@index([isFeatured, isPublished])
  @@index([soldCount])
}

// Phase 010: tenant hero banners for storefront carousel (R2-hosted, zero-egress CDN)
model Banner {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  imageUrl     String
  targetUrl    String   @default("/")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, isActive])
}

model PhysicalDetail {
  id          String   @id @default(uuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isbn        String?  @unique
  weightGrams Int      @default(0)
  lengthCm    Decimal? @db.Decimal(6, 2)
  widthCm     Decimal? @db.Decimal(6, 2)
  heightCm    Decimal? @db.Decimal(6, 2)
  stockQty    Int      @default(0)
  reservedQty Int      @default(0)
  sku         String   @unique
  // Atomic Phase 075: per-warehouse ledger rows (aggregate sync target)
  warehouseStocks WarehouseStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EbookDetail {
  id            String         @id @default(uuid())
  productId     String         @unique
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalPages    Int
  previewPages  Int            @default(10)
  storagePathR2 String
  fileHash      String         @db.VarChar(64)
  chapters      EbookChapter[]
  // Atomic Phase 036: R2 vault mapping + per-page chunk manifests
  r2VaultAsset   StorageVaultAsset? @relation("EbookR2Source")
  chunkManifests EbookChunkMeta[]
  // Atomic Phase 038: pipeline chunk envelopes + AI/search text layer
  chunks         EbookChunk[]
  pageTexts      EbookPageText[]
  // Atomic Phase 041: reader bookmarks + highlights (cascade with the book)
  bookmarks      EbookBookmark[]
  highlights     EbookHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EbookChapter {
  id            String      @id @default(uuid())
  ebookId       String
  ebook         EbookDetail @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  chapterIndex  Int
  title         String
  chunkCount    Int
  chunkR2Prefix String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ebookId, chapterIndex])
}

model CourseDetail {
  id                 String          @id @default(uuid())
  productId          String          @unique
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalHours         Float           @default(0.0)
  certificateEnabled Boolean         @default(true)
  dripContentEnabled Boolean         @default(false)
  sections           CourseSection[]
  // Atomic Phase 048: course certificates
  certificates       CourseCertificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Atomic Phase 048: Auto-Certificate PDF Engine with QR Code & HMAC-SHA256
model CourseCertificate {
  id                   String       @id @default(uuid())
  certificateNo        String       @unique
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId             String
  course               CourseDetail @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantId             String?
  issuedAt             DateTime     @default(now())
  pdfStoragePathR2     String
  qrCodeUrl            String
  digitalSignatureHash String
  status               String       @default("ISSUED") // ISSUED, REVOKED, EXPIRED
  metadataJson         Json?        // Additional custom fields (e.g., Grade, Hours)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([userId, courseId])
  @@index([certificateNo])
  @@index([userId])
}

// Atomic Phase 049: DRM Canvas Shuffling (ephemeral sessions + violation audit)
// Atomic Phase 061: shuffle algorithm set (canonical per schema.md §DrmAlgorithm).
enum DrmAlgorithm {
  TILE_GRID_PERMUTATION
  PIXEL_BYTE_XOR_SHUFFLE
  HYBRID_WEBGL_MATRIX
}

enum DrmViolationType {
  SCREENSHOT_ATTEMPT
  DEVTOOLS_CANVAS_DUMP
  UNAUTHORIZED_DOM_INJECTION
  SESSION_HIJACK_ATTEMPT
}

model DrmSession {
  id                String            @id @default(uuid())
  userId            String
  productId         String
  pageNumber        Int
  sessionSeed       String
  permutationVector Json
  tileWidth         Int               @default(64)
  tileHeight        Int               @default(64)
  gridCols          Int
  gridRows          Int
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  violationLogs     DrmViolationLog[]

  @@index([userId, productId])
  @@index([expiresAt])
}

model DrmViolationLog {
  id            String           @id @default(uuid())
  // Atomic Phase 061: trap violations may arrive without a Phase-049
  // DrmSession (nullable FK; all existing rows keep their sessionId).
  sessionId     String?
  drmSession    DrmSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  violationType DrmViolationType
  ipAddress     String
  userAgent     String
  metadata      Json?
  createdAt     DateTime         @default(now())
  // Atomic Phase 061: dual-DRM trap attribution (additive; nullable so all
  // Phase 049 rows stay valid). violationType stays an enum (stricter than
  // the §4.1 String sketch — RISK_CALL deviation, documented in ADR-061).
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  pageNumber    Int?

  @@index([violationType])
  @@index([createdAt])
  @@index([userId])
  @@index([productId])
}

// Atomic Phase 062 Task 1: offline PWA sync ledger (additive; progress
// tables EbookReadingProgress/CourseLearningProgress reused untouched).
model OfflineDeviceSession {
  id           String           @id @default(uuid())
  userId       String
  deviceId     String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSyncedAt DateTime         @updatedAt
  syncLogs     OfflineSyncLog[]

  @@unique([userId, deviceId])
  @@index([userId])
}

model OfflineSyncLog {
  id         String               @id @default(uuid())
  sessionId  String
  deviceSession OfflineDeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetType String
  itemsCount Int                  @default(1)
  status     String               @default("SUCCESS")
  createdAt  DateTime             @default(now())
  // Atomic Phase 063: user-scoped audit shape (additive; nullable so all
  // Phase 062 session rows stay valid — RISK_CALL deviation, ADR-063).
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  syncedRecords Int?
  syncPayload   Json?
  ipAddress     String?

  @@index([sessionId])
  @@index([userId])
}

// Atomic Phase 064: batch sync audit log (additive).
model ProgressSyncAuditLog {
  id               String   @id @default(uuid())
  userId           String
  syncBatchId      String   @unique
  itemCount        Int
  conflictsHandled Int      @default(0)
  ipAddress        String
  userAgent        String
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Atomic Phase 063 Task 2: offline DRM lease registry (additive).
model DrmOfflineLease {
  id              String   @id @default(uuid())
  userId          String
  productId       String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  deviceId        String
  clientPublicKey String   @db.Text
  leaseToken      String   @db.Text
  issuedAt        DateTime @default(now())
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, productId, deviceId])
  @@index([userId])
  @@index([expiresAt])
}

// Atomic Phase 061 Task 1: dual-DRM ephemeral session keys (additive;
// zero rewrites — OUT_OF_SCOPE_STRICT respected).
model DrmSecurityKey {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sessionNonce String       @unique @default(uuid())
  hmacSecret   String
  algorithm    DrmAlgorithm @default(HYBRID_WEBGL_MATRIX)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@index([userId, productId])
  @@index([sessionNonce])
}

// Atomic Phase 078: studio HLS transcode lifecycle (schema.md canonical).
enum HlsTranscodeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CourseSection {
  id           String         @id @default(uuid())
  courseId     String
  course       CourseDetail   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionOrder Int
  title        String
  lessons      CourseLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, sectionOrder])
}

model CourseLesson {
  id          String        @id @default(uuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lessonOrder Int
  title       String
  videoHlsUrl String
  durationSec Int           @default(0)
  isPreview   Boolean       @default(false)
  // Atomic Phase 078: studio HLS pipeline (additive; existing cols untouched)
  rawStorageKey   String?
  transcodeStatus HlsTranscodeStatus @default(PENDING)
  // Atomic Phase 037: in-lesson quizzes (simple spec shape; quiz engine expands)
  quizzes     LessonQuiz[]
  // Atomic Phase 036: R2 HLS prefix + segment manifests + vault mapping
  r2HlsPrefix   String?
  r2VaultAsset  StorageVaultAsset? @relation("LessonVideoR2Source")
  hlsSegments   HlsSegmentMeta[]
  // Atomic Phase 050: active playback sessions guarding segment fetches
  streamSessions VideoStreamSession[]
  // Atomic Phase 051: free preview gate (first 120s watchable without entitlement)
  isPreviewAllowed Boolean @default(true)
  previewLimitSec  Int     @default(120)
  // Atomic Phase 058: high-performance thumbnail scrubbing metadata
  // (additive expand-contract: nullable/defaulted cols + 1 new table only).
  hasSpriteScrubbing Boolean @default(false)
  spriteVttUrl       String?
  spriteIntervalSec  Int     @default(2)
  tileWidth          Int     @default(160)
  tileHeight         Int     @default(90)
  columnsCount       Int     @default(10)
  spriteSheets       VideoSpriteSheet[]
  // Atomic Phase 065: in-video timestamped lesson notes
  notes              LessonNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, lessonOrder])
}

// Atomic Phase 065: in-video lesson note engine (timestamp-linked notes).
enum NoteVisibility {
  PRIVATE
  STUDY_GROUP
  PUBLIC
}

model LessonNote {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       CourseLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId     String
  timestampSec Int
  content      String         @db.Text
  tags         String[]       @default([])
  visibility   NoteVisibility @default(PRIVATE)
  aiSummary    String?        @db.Text

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId, timestampSec])
  @@index([visibility])
}

model BundleItem {
  id             String  @id @default(uuid())
  parentBundleId String
  parentBundle   Product @relation("ParentBundle", fields: [parentBundleId], references: [id], onDelete: Cascade)
  childProductId String
  childProduct   Product @relation("ChildProducts", fields: [childProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentBundleId, childProductId])
}

model Category {
  id          String               @id @default(uuid())
  // Phase 009: tenant-scoped taxonomy for faceted discovery (expand-contract; nullable until backfill)
  tenantId    String?
  name        String
  slug        String               @unique
  description String?
  products    ProductCategoryMap[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
}

model ProductCategoryMap {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Tag {
  id       String          @id @default(uuid())
  name     String          @unique
  products ProductTagMap[]
}

model ProductTagMap {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Entitlement {
  id         String            @id @default(uuid())
  userId     String
  productId  String
  accessType ContentAccessType @default(FULL_PURCHASE)
  expiresAt  DateTime?
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  // Atomic Phase 018: library sort/filter indexing (RECENTLY_ACCESSED / access-type tabs)
  updatedAt  DateTime          @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([userId, accessType])
  @@index([createdAt])
}

// Atomic Phase 012: order lifecycle + payment verification states (expand-contract)
// Atomic Phase 013: + EXPIRED (time-bound QR auto-cancel, additive)
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFYING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PENDING_SLIP
  VERIFIED
  FAILED
  REFUNDED
}

// Atomic Phase 013: dynamic PromptPay QR lifecycle (fractional-cent matching)
enum PromptPayStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model Order {
  id                   String                   @id @default(uuid())
  // Phase 012: optional multi-tenant ownership (expand-contract; required after backfill)
  tenantId             String?
  orderNumber          String                   @unique
  userId               String
  user                 User                     @relation(fields: [userId], references: [id])
  totalAmount          Decimal                  @default(0.00) @db.Decimal(10, 2)
  shippingFee          Decimal                  @default(0.00) @db.Decimal(10, 2)
  discountAmount       Decimal                  @default(0.00) @db.Decimal(10, 2)
  netAmount            Decimal                  @db.Decimal(10, 2)
  orderStatus          OrderStatus              @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus            @default(UNPAID)
  trackingNumber       String?
  orderItems           OrderItem[]
  paymentSlip          PaymentSlip?
  // Phase 013: 1:1 dynamic QR lifecycle (fractional cent + TTL expiry)
  promptPayTransaction PromptPayTransaction?
  // Phase 015: transactional outbox (LINE flex / affiliate / AI consumers)
  outboxEvents         OutboxEvent[]
  // Atomic Phase 019: transactional receipt logs (Log & Notification scope only)
  receiptLogs          ReceiptNotificationLog[]
  // Atomic Phase 073: merchant fulfillment (1:1 shipping/warehouse leg)
  fulfillment          OrderFulfillment?
  // Atomic Phase 076: batch fulfillment ledger (queue -> booked -> label)
  fulfillmentItems     FulfillmentItem[]
  // Atomic Phase 077: shipment tracking ledger (webhook-driven status)
  shipments            Shipment[]
  // Atomic Phase 079: multi-tier commission ledger
  commissionLogs       CommissionLog[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([orderNumber])
  @@index([orderStatus, paymentStatus])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  @@index([orderId])
  @@index([productId])
}

model PaymentSlip {
  id               String    @id @default(uuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slipImageUrl     String
  transRef         String?   @unique
  sendingBank      String?
  // Phase 015: receiving bank name (spec §4.1; additive)
  receivingBank    String?
  receivingAccount String?
  amount           Decimal   @db.Decimal(10, 2)
  verifiedAt       DateTime?
  apiRawResponse   Json?
  // Phase 014 §8: SHA-256 forensic hash (duplicate detection across filenames)
  slipSha256       String?
  createdAt        DateTime  @default(now())

  @@index([slipSha256])
}

// Atomic Phase 015 §4.1: transactional outbox (canonical schema.md shape)
// Durability record for post-commit fan-out (LINE flex / affiliate / AI).
// The dispatcher publishes to `stream:outbox:<eventType>` then marks processed.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String // e.g. "ORDER"
  aggregateId   String // orderId
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType     String // "PAYMENT_VERIFIED_ENTITLEMENT_GRANTED" | "SLIP_VERIFY_RETRY"
  payload       Json
  isProcessed   Boolean   @default(false)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([isProcessed, createdAt])
  @@index([aggregateType, aggregateId])
}

// Atomic Phase 013: dynamic PromptPay QR lifecycle (spec §4.1, canonical schema.md)
model PromptPayTransaction {
  id             String          @id @default(uuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promptPayId    String // Biller ID or Mobile / Tax ID
  qrPayload      String          @db.Text
  ref1           String
  ref2           String?
  baseAmount     Decimal         @db.Decimal(10, 2)
  fractionalCent Decimal         @default(0.00) @db.Decimal(3, 2)
  totalAmount    Decimal         @db.Decimal(10, 2)
  expiresAt      DateTime
  status         PromptPayStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([expiresAt])
  @@index([ref1])
  @@index([totalAmount, status])
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient    String
  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  subdistrict  String
  district     String
  province     String
  postalCode   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CreatorKYC {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idCardNumberEnc   String // AES-256-GCM encrypted ID card number
  idCardImageUrl    String // Cloudflare R2 private bucket object key
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  taxId             String?
  verifiedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json
  ipAddress String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// Atomic Phase 005: Unified Auth Middleware & JWT Session SSO
// (LINE LIFF / LINE Web / Google / Email+Password + single-use refresh rotation)
model Account {
  id                String   @id @default(uuid())
  userId            String
  // NOTE: spec §4.1 typed provider as UserRole; canonical uses String provider key
  // (e.g. LINE_LIFF / LINE_WEB / GOOGLE / EMAIL_PASSWORD) to avoid enum misuse.
  provider          String // External provider key, e.g. lineUserId or googleSub
  providerAccountId String // External ID e.g., lineUserId or googleSub
  refreshToken      String?  @db.Text
  accessToken       String?  @db.Text
  expiresAt         Int?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  sessionToken String   @unique
  refreshToken String   @unique
  deviceOs     String?
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model AuthAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId  String
