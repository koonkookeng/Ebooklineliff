// SSOT Phase 0 core — source: Phases/phase_000.md §4.1
// Full 279-model version is generated to packages/db/prisma/schema.full.prisma by scaffold script from schema.md
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

enum UserRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  CONTENT_MODERATOR
  SUPPORT_STAFF
  INSTRUCTOR
  SELLER
  MEMBER
}

enum ProductType {
  PHYSICAL_BOOK
  EBOOK
  ELEARNING_COURSE
  LIVE_CLASS
  HYBRID_BUNDLE
}

// Atomic Phase 008: catalog lifecycle (DRAFT -> PUBLISHED -> ARCHIVED/SUSPENDED)
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum ContentAccessType {
  FULL_PURCHASE
  SUBSCRIPTION
  CORPORATE_LICENSE
  TIME_LIMITED_RENTAL
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  // Atomic Phase 085: manual-review state (schema.md canonical union)
  ACTION_REQUIRED
}

// Atomic Phase 085 §4.1: payout account lifecycle (schema.md canonical).
enum PayoutAccountStatus {
  INACTIVE
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id                String                   @id @default(uuid())
  lineUserId        String?                  @unique
  email             String?                  @unique
  phone             String?                  @unique
  passwordHash      String?
  role              UserRole                 @default(MEMBER)
  kycStatus         KYCStatus                @default(NOT_SUBMITTED)
  // Atomic Phase 109: central-admin freeze switch (additive; default unfrozen).
  isFrozen          Boolean                  @default(false)
  freezeReason      String?
  displayName       String
  avatarUrl         String?
  walletBalance     Decimal                  @default(0.00) @db.Decimal(12, 2)
  rewardPoints      Int                    @default(0)
  affiliateCode     String                   @unique @default(uuid())
  referredById      String?
  referredBy        User?                    @relation("AffiliateReferrals", fields: [referredById], references: [id])
  referrals         User[]                   @relation("AffiliateReferrals")
  addresses         UserAddress[]
  kycDetail         CreatorKYC?
  auditLogs         AuditLog[]
  // Atomic Phase 109: admin-action audit trail (executor/target views; additive).
  executedAdminActions AuditLog[]            @relation("AdminExecutor")
  targetedAdminActions AuditLog[]           @relation("TargetUser")
  // Atomic Phase 109: admin wallet-adjustment ledger (additive).
  walletAuditLedgers WalletAuditLedger[]
  // Atomic Phase 110: 360 inspector ledger (RFM metrics + telemetry + security).
  // NOTE: `securityAuditLogs` is owned by Phase 106 (SecurityAuditLog) —
  // the 110 ledger rides `inspectorSecurityLogs`.
  user360Metric       User360Metric?
  ebookPageReadLogs   EbookPageReadLog[]
  videoWatchTelemetries UserVideoWatchTelemetry[]
  inspectorSecurityLogs UserSecurityAuditLog[]
  accounts          Account[]
  sessions          Session[]
  authAuditLogs     AuthAuditLog[]
  // Phase 006: optional multi-tenant binding (expand-contract; required after backfill)
  tenantId          String?
  tenant            Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lineProfile       LineAuthProfile?
  entitlements      Entitlement[]
  orders            Order[]
  cart              Cart?
  readingProgress   EbookReadingProgress[]
  learningProgress  CourseLearningProgress[]
  // Atomic Phase 047: in-video quiz attempts
  quizAttempts      QuizAttempt[]
  // Atomic Phase 048: course certificates
  courseCertificates CourseCertificate[]
  // Atomic Phase 049: DRM sessions (ephemeral tile-permutation grants)
  drmSessions       DrmSession[]
  // Atomic Phase 061: dual-DRM ephemeral session keys (HMAC permutation grants)
  drmSecurityKeys   DrmSecurityKey[]
  drmViolationLogs  DrmViolationLog[]
  // Atomic Phase 062: offline PWA device sessions (bulk-sync ledger)
  offlineDeviceSessions OfflineDeviceSession[]
  // Atomic Phase 063: offline sync audit + DRM lease grants
  offlineSyncAudits     OfflineSyncLog[]
  drmOfflineLeases      DrmOfflineLease[]
  // Atomic Phase 065: in-video timestamped lesson notes
  notes             LessonNote[]
  // Atomic Phase 095: social margin notes + reactions + owned study groups
  socialNotes       SocialNote[]
  noteReactions     SocialNoteReaction[]
  ownedStudyGroups  StudyGroup[] @relation("OwnedStudyGroups")
  // Atomic Phase 096: squad memberships + point ledger
  squadMemberships  SquadMember[]
  pointTransactions PointTransaction[]
  // Atomic Phase 097: corporate seat assignments
  corporateSeats    CorporateSeat[]
  // Atomic Phase 098: HR organization seat (1-1 optional back-relation)
  b2bSeat           B2BCorporateSeat?
  // Atomic Phase 099: instructed live sessions + chat/vote rows
  liveSessions      LiveSession[] @relation("InstructorSessions")
  liveChatMessages  LiveChatMessage[]
  livePollVotes     LivePollVote[]
  // Atomic Phase 101: hand-raise requests
  liveHandRaises    LiveHandRaise[]
  // Atomic Phase 103: helpdesk tickets + bot history
  supportTickets    SupportTicket[]
  // Atomic Phase 104: preference profile + interaction/slate logs
  preferenceProfile UserPreferenceProfile?
  interactionLogs   UserInteractionLog[]
  slateLogs         RecommendationSlateLog[]
  // Atomic Phase 106: granular RBAC assignments + security audit trail
  tenantRoleAssignments UserTenantRole[]
  securityAuditLogs     SecurityAuditLog[]
  // Atomic Phase 107: field-level encrypted PII vault (1:1, blind-index search)
  piiVault              UserPII?
  // Atomic Phase 100: room entitlements + active (kickable) sessions
  liveEntitlements  LiveEntitlement[]
  liveActiveSessions LiveActiveSession[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  scannedQrSessions QrSessionNonce[]         @relation("QrScannedBy")
  deviceSessions    UserDeviceSession[]
  // Atomic Phase 017: internal wallet (Meb-Killer Credits, bonus-first debit)
  wallets           Wallet[]
  // Atomic Phase 086: payout-hold audit rows (clearing trail)
  walletLedgers     WalletLedger[] @relation("ClearingAudit")
  // Atomic Phase 022: device viewport/safe-area metrics (async analytics, nullable user)
  userDeviceMetrics UserDeviceMetric[]
  // Atomic Phase 026: viral share logs + referral attributions
  shareLogs           ShareLog[]
  viralAttributions   ViralAttribution[]
  // Atomic Phase 027: LIFF navigation session (single active snapshot per user)
  navigationSessions  UserNavigationSession[]
  // Atomic Phase 031: viewport keep-alive rows (one per user/tenant/viewport)
  liffSessionStates   UserLiffSessionState[]
  // Atomic Phase 032: permission audit trail + district-level location cache
  permissionAudits    PermissionAuditLog[]
  locationCache       UserLocationCache?
  // Atomic Phase 034: LINE OA friendship flag + audit trail
  isOAFriend            Boolean               @default(false)
  oaFriendshipUpdatedAt DateTime?
  oaFriendshipLogs      LineOAFriendshipLog[]
  // Atomic Phase 041: reader bookmarks + highlights + reading preferences
  bookmarks         EbookBookmark[]
  highlights        EbookHighlight[]
  readerPreference  UserReaderPreference?
  // Atomic Phase 066: cross-platform synced reading preferences
  readingPreference UserReadingPreference?
  // Atomic Phase 042: watermark seeds + tamper audit trail
  watermarkSeeds      WatermarkSeedLog[]
  securityViolations  SecurityViolationLog[]
  // Atomic Phase 050: HLS stream sessions + scraper blacklist (anti-rip guard)
  videoStreamSessions VideoStreamSession[]
  scraperBlacklists   ScraperBlacklist[]
  // Atomic Phase 052: read/watch telemetry rows (async batch writer owns writes)
  ebookPageAnalytics  EbookPageAnalytics[]
  videoWatchAnalytics VideoWatchAnalytics[]
  // Atomic Phase 067: ABR quality telemetry ledger
  streamTelemetry     VideoStreamTelemetry[]
  // Atomic Phase 068: offline download licenses + device storage profiles
  offlineLicenses     OfflineLicense[]
  storageProfiles     DeviceStorageProfile[]
  // Atomic Phase 069: network telemetry segments
  networkTelemetry    NetworkTelemetryLog[]
  // Atomic Phase 070: cross-device vector-clock state
  // (ActiveDeviceSession stays relation-free per Phase 057 — the viewport
  // guard counts by userId field, no schema touch).
  crossDeviceStates   CrossDeviceSyncState[]
  // Atomic Phase 071: tenant memberships (per-storefront RBAC)
  tenantMappings      UserTenantMapping[]
  // Atomic Phase 073: merchant storefront profile (1:1 seller account)
  merchantProfile     MerchantProfile?
  // Atomic Phase 075: stock audit authorship
  stockMovementLogs   StockMovementLog[]
  // Atomic Phase 079: multi-tier affiliate ledger
  commissionsEarned    CommissionLog[] @relation("EarnedCommissions")
  commissionsGenerated CommissionLog[] @relation("GeneratedCommissions")
  affiliatePayouts     AffiliatePayout[]
  financePayouts       PayoutTransaction[] @relation("FinancePayouts")
  // Atomic Phase 082: tax profile (1:1) + 50 Tawi certificates
  taxProfile           UserTaxProfile?
  taxCertificates      WithholdingTaxCertificate[]
  // Atomic Phase 083: streak (1:1) + check-ins + badges + redemptions
  streak               UserStreak?
  checkins             DailyCheckin[]
  userBadges           UserBadge[]
  redemptions          RewardRedemption[]
  // Atomic Phase 087: flash stock reservations
  stockReservations    StockReservation[]
  // Atomic Phase 088: coupon redemptions
  couponRedemptions    CouponRedemption[]
  // Atomic Phase 089: sent/received gifts
  sentGifts            GiftOrder[] @relation("SentGifts")
  receivedGifts        GiftOrder[] @relation("ReceivedGifts")
  // Atomic Phase 090: created group-buy rooms + memberships
  createdGroupRooms    GroupBuyingRoom[] @relation("CreatedGroupRooms")
  groupMemberships     GroupBuyingMember[]
  // Atomic Phase 092: AI chat sessions + learning insight (1:1)
  aiChatSessions       AiChatSession[]
  learningInsight      UserLearningInsight?
  // Atomic Phase 093: IRT adaptive profile (per subject) + quiz responses
  adaptiveProfiles     UserAdaptiveProfile[]
  quizResponses        AdaptiveQuizResponse[]
  // Atomic Phase 094: creator co-pilot jobs
  copilotJobs          AiCoPilotJob[]
  shareEvents          ShareEvent[]

  @@index([lineUserId])
  @@index([email])
  @@index([phone])
  @@index([affiliateCode])
  @@index([tenantId])
  // Atomic Phase 109: admin universal-query engine (filter/sort/page <200ms).
  @@index([role, kycStatus])
  @@index([createdAt])
  @@index([walletBalance])
  @@index([displayName])
  // Atomic Phase 034: friendship-segment queries (OA conversion funnel)
  @@index([isOAFriend])
}

// Atomic Phase 083 §4.1: gamification segment (schema.md canonical).
enum BadgeCategory {
  READING_MILESTONE
  LEARNING_STREAK
  PURCHASE_COMMUNITY
  SOCIAL_AFFILIATE
  SPECIAL_EVENT
}

enum RewardType {
  EBOOK_UNLOCK
  COURSE_UNLOCK
  DISCOUNT_COUPON
  PHYSICAL_ITEM
  STREAK_FREEZE_ITEM
}

enum RedemptionStatus {
  COMPLETED
  PENDING_SHIPMENT
  CANCELLED
}

model UserStreak {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCheckinDate   DateTime? @db.Date
  streakFreezeCount Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

model DailyCheckin {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkinDate     DateTime @db.Date
  streakCount     Int      @default(1)
  pointsEarned    Int      @default(10)
  bonusMultiplier Decimal  @default(1.00) @db.Decimal(3, 2)
  isFrozenUsed    Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, checkinDate])
  @@index([userId])
  @@index([checkinDate])
}

model Badge {
  id                String        @id @default(uuid())
  code              String        @unique
  name              String
  description       String
  iconUrl           String
  category          BadgeCategory @default(READING_MILESTONE)
  criteriaType      String
  criteriaThreshold Int
  pointsReward      Int           @default(100)
  userBadges        UserBadge[]
  createdAt         DateTime      @default(now())
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model RewardItem {
  id             String             @id @default(uuid())
  title          String
  description    String             @db.Text
  imageUrl       String
  rewardType     RewardType
  pointsRequired Int
  stockQty       Int                @default(0)
  productId      String?
  discountAmount Decimal?           @db.Decimal(10, 2)
  isPublished    Boolean            @default(true)
  redemptions    RewardRedemption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([rewardType])
}

model RewardRedemption {
  id             String           @id @default(uuid())
  redemptionCode String           @unique @default(uuid())
  userId         String
  rewardItemId   String
  pointsSpent    Int
  status         RedemptionStatus @default(COMPLETED)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItem     RewardItem       @relation(fields: [rewardItemId], references: [id])
  redeemedAt     DateTime         @default(now())

  @@index([userId])
  @@index([redemptionCode])
}

// Atomic Phase 006: tenant registry for LIFF seamless auth (lineChannelId selects verify audience).
// NOTE: `users` back-relation intentionally omitted (one-sided relation) until the User.tenantId
// backfill migration lands; AuthService binds tenantId at auto-provision time.
// Atomic Phase 071: TenantStatus lifecycle + branding/domain/membership relations
// (expand-contract additive; Order stays one-sided — no orders[] back-relation
// until Order.tenant FK backfill lands).
enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
  ARCHIVED
}

model Tenant {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  domain        String?   @unique
  lineChannelId String?
  logoUrl       String?
  primaryColor  String    @default("#00C300")
  isActive      Boolean   @default(true)
  // Phase 008: dynamic branding tokens (--primary-color, etc.) + catalog ownership
  customCssVars Json?
  products      Product[]
  brandingConfig TenantBrandingConfig?
  customDomains TenantDomain[]
  companies     TenantCompany[]
  memberships   UserTenantMapping[]
  themeConfig   CompanyTheme?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  User          User[]

  @@index([slug])
  @@index([status])
}

// Atomic Phase 071: verified custom domains (brand-a.com -> tenant).
model TenantDomain {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domainName String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([domainName])
  @@index([tenantId])
}

// Atomic Phase 071: per-tenant dynamic branding (CSS vars injection source).
model TenantBrandingConfig {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("#ffffff")
  accentColor    String   @default("#10b981")
  logoUrl        String
  faviconUrl     String?
  customFontUrl  String?
  updatedAt      DateTime @updatedAt
}

// Atomic Phase 071: user <-> tenant membership (RBAC per storefront).
model UserTenantMapping {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// Atomic Phase 072: full company theme (logo set + typography + surfaces).
// 1:1 with Tenant; served via Redis `tenant:company-theme:{slug}` (24h).
model CompanyTheme {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor         String   @default("#059669")
  secondaryColor       String   @default("#10B981")
  accentColor          String   @default("#F59E0B")
  backgroundColor      String   @default("#FFFFFF")
  textColor            String   @default("#0F172A")
  borderRadiusRem      Float    @default(0.5)
  primaryLogoUrl       String
  squareLogoUrl        String?
  faviconUrl           String?
  watermarkLogoUrl     String?
  fontFamily           String   @default("Inter")
  fontUrl              String?
  isAccessibilityValid Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
}

// Atomic Phase 073: merchant & studio segment (dashboard SSOT).
// Atomic Phase 076: union with 076 lifecycle (schema.md canonical).
enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  QUEUED_FOR_BOOKING
  BOOKED
  LABEL_GENERATED
  PRINTED
  IN_TRANSIT
  DELIVERY_FAILED
  CANCELLED
}

// Atomic Phase 076: multi-carrier vocabulary (schema.md canonical).
enum CourierProvider {
  FLASH_EXPRESS
  KEX_EXPRESS
  JT_EXPRESS
  THAILAND_POST
  CUSTOM_FLEET
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  // Atomic Phase 079: affiliate payout request lifecycle (schema.md canonical union)
  REQUESTED
  // Atomic Phase 081: finance bank-settlement lifecycle (schema.md canonical union)
  PROCESSING_BANK
  SUCCESS
  FAILED
  // Atomic Phase 086: clearing lifecycle (BDD-1 PENDING_APPROVAL, BDD-2 FAILED_BANK_TRANSFER)
  PENDING_APPROVAL
  FAILED_BANK_TRANSFER
}

// Atomic Phase 081: double-entry vocabulary (schema.md canonical).
enum LedgerAccountType {
  CASH_EQUIVALENT
  SELLER_PAYABLE
  AFFILIATE_PAYABLE
  PLATFORM_REVENUE_FEE
  WITHHOLDING_TAX_PAYABLE
  ESCROW_HOLD
}

enum EntryType {
  DEBIT
  CREDIT
}

// Atomic Phase 079: multi-tier affiliate vocabulary (schema.md canonical).
enum AffiliateTierLevel {
  TIER_1_DIRECT
  TIER_2_INDIRECT
  TIER_3_COMMUNITY
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
  BLOCKED_FRAUD
}

model MerchantProfile {
  id              String              @id @default(uuid())
  tenantId        String              @unique
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName       String
  storeSlug       String              @unique
  logoUrl         String?
  bannerUrl       String?
  taxId           String?
  vatRegistered   Boolean             @default(false)
  bankName        String
  bankAccountNo   String
  bankAccountName String
  warehouses      Warehouse[]
  payouts         PayoutTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId])
}

model Warehouse {
  id                String             @id @default(uuid())
  merchantProfileId String
  merchantProfile   MerchantProfile  @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)
  warehouseName     String
  addressLine       String
  province          String
  postalCode        String
  isPrimary         Boolean            @default(true)
  fulfillments      OrderFulfillment[]
  // Atomic Phase 075: stock ledger extensions (additive; 073 cols untouched).
  // `code` is the operator-facing key (GQL §3.2); `name` falls back to
  // warehouseName at the service layer when unset.
  tenantId          String?
  code              String?            @unique
  name              String?
  isMainWarehouse   Boolean            @default(false)
  isActive          Boolean            @default(true)
  stocks            WarehouseStock[]
  movementLogs      StockMovementLog[]
  // Atomic Phase 076: batch fulfillment ledger rows
  fulfillmentItems  FulfillmentItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
  @@index([code])
}

model OrderFulfillment {
  id               String            @id @default(uuid())
  orderId          String            @unique
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  status           FulfillmentStatus @default(UNFULFILLED)
  courierName      String?
  trackingNumber   String?           @unique
  shippingLabelUrl String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([warehouseId])
  @@index([status])
}

// Atomic Phase 076: tenant carrier credentials (1:1 per provider).
model LogisticsCarrierConfig {
  id            String          @id @default(uuid())
  tenantId      String
  provider      CourierProvider
  accountNo     String
  apiKey        String
  apiSecret     String?
  sortingCode   String?
  isAutoBooking Boolean         @default(true)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([tenantId, provider])
}

// Atomic Phase 076: batch booking header (BDD-1: 100 items < 2s).
model FulfillmentBatch {
  id              String            @id @default(uuid())
  batchNumber     String            @unique
  tenantId        String
  courierProvider CourierProvider
  totalOrders     Int
  successCount    Int               @default(0)
  failureCount    Int               @default(0)
  status          String            @default("PROCESSING")
  items           FulfillmentItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
}

// Atomic Phase 076: per-order fulfillment ledger (queue -> booked -> label -> printed).
model FulfillmentItem {
  id              String            @id @default(uuid())
  batchId         String?
  batch           FulfillmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  orderId         String            @unique
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  courierProvider CourierProvider
  trackingNumber  String?           @unique
  sortingCode     String?
  labelUrl        String?
  status          FulfillmentStatus @default(UNFULFILLED)
  printedAt       DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([courierProvider])
  @@index([status])
  @@index([trackingNumber])
}

// Atomic Phase 077: API-integrated carrier vocabulary (schema.md canonical).
enum LogisticsCarrier {
  FLASH_EXPRESS
  KERRY_EXPRESS
  THAILAND_POST
}

enum ShipmentStatus {
  PENDING_BOOKING
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
}

// Atomic Phase 077: tenant carrier API credentials (multi-tenant scope;
// schema.md canonical is global-@unique — tenant scope documented deviation).
model CarrierApiConfig {
  id        String           @id @default(uuid())
  tenantId  String           @default("default")
  carrier   LogisticsCarrier
  mchId     String
  apiKey    String           @db.Text
  apiSecret String           @db.Text
  isSandbox Boolean          @default(false)
  isActive  Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, carrier])
}

// Atomic Phase 077: shipment tracking ledger (webhook-driven status).
model Shipment {
  id              String           @id @default(uuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier         LogisticsCarrier
  trackingNumber  String           @unique
  courierOrderId  String?
  labelUrl        String?          @db.Text
  status          ShipmentStatus   @default(PENDING_BOOKING)
  weightGrams     Int
  shippingFee     Decimal          @db.Decimal(10, 2)
  senderName      String
  senderPhone     String
  recipientName   String
  recipientPhone  String
  destinationAddr String           @db.Text
  trackingLogs    TrackingHistory[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([trackingNumber])
  @@index([carrier, status])
}

model TrackingHistory {
  id             String   @id @default(uuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  statusCode     String
  statusText     String
