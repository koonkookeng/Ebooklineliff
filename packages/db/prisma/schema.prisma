  ebook          EbookDetail @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  pageNumber     Int
  r2ObjectKey    String
  chunkSizeBytes Int
  vectorChecksum String

  @@unique([ebookId, pageNumber])
  @@index([ebookId])
}

model HlsSegmentMeta {
  id           String       @id @default(uuid())
