  question    String       @db.Text
  optionsJson Json
  answerKey   String
  // Atomic Phase 047: in-video checkpoint expansion (all defaulted; legacy rows stay valid)
  timestampSec    Int       @default(0)
  // Atomic Phase 078: studio quiz builder points (additive)
  points          Int       @default(10)
  quizType        QuizType  @default(SINGLE_CHOICE)
  passScore       Float     @default(100.0)
  maxRetries      Int       @default(0)
  explanation     String?   @db.Text
  aiPromptContext String?   @db.Text
  options         QuizOption[]
  attempts        QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([lessonId, timestampSec])
