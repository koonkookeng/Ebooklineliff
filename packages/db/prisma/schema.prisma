// Atomic Phase 070: vector-clock SSOT row + one-time handshake tokens.
// - CrossDeviceSyncState persists the Redis edge winner (write-behind).
// - HandshakeToken is consumed via Redis GETDEL (single-use, 120s TTL);
//   the row is an audit trail (BDD-4 session guard evidence).
model CrossDeviceSyncState {
  id             String   @id @default(uuid())
  userId         String
  productId      String
  contentType    String
  lastPage       Int?     @default(1)
  lastWatchedSec Int?     @default(0)
  vectorClock    Int      @default(1)
  lastDevice     String

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, productId, contentType])
  @@index([userId, productId])
}

model HandshakeToken {
  id             String   @id @default(uuid())
  handshakeToken String   @unique
  lineUserId     String
  webSessionId   String?
  isConsumed     Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([handshakeToken])
}
