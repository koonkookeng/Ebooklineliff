{
  "name": "@ebook-liff/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('fs'),p=require('path');const walk=(d,o=[])=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=p.join(d,e.name);if(e.isDirectory())walk(f,o);else if(f.endsWith('.graphql'))o.push(f)}return o};for(const f of walk('src')){const t=p.join('dist',p.relative('src',f));fs.mkdirSync(p.dirname(t),{recursive:true});fs.copyFileSync(f,t)}\"",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate --schema ../../packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/fastify": "^2.1.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prisma/client": "^5.22.0",
    "@repo/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.10.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
